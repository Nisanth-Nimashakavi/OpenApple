{
  "name": "@lordnimnim/openapple",
  "version": "0.4.0",
  "description": "Feed Claude, AGY, and Codex a crisp apple when they finish a task \u2014 the benevolent opposite of OpenWhip",
  "publishConfig": {
    "access": "public"
  },
  "main": "main.js",
  "bin": {
    "openapple": "bin/openapple.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/desktop.test.cjs tests/delivery.test.cjs",
    "check": "node scripts/check_syntax.cjs",
    "test:desktop": "node scripts/check_desktop.cjs",
    "format:check": "prettier --check main.js preload.js overlay.js overlay.css \"desktop/*.cjs\" \"desktop/native/*.js\" \"bin/*.js\" \"tests/*.cjs\" \"scripts/*.cjs\""
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "claude",
    "antigravity",
    "codex",
    "agent",
    "openapple",
    "openwhip"
  ],
  "author": "OpenApple Community",
  "license": "MIT",
  "files": [
    "bin",
    "icon",
    "sounds",
    "main.js",
    "overlay.html",
    "preload.js",
    "openapple/*.py",
    "install.sh",
    "install.ps1",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "GEMINI.md",
    "README.md",
    "pyproject.toml",
    "desktop",
    "overlay.js",
    "overlay.css",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/VALIDATION.md",
    "docs/FIX_STATUS.md",
    "docs/QUALITY_REVIEW.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "electron": "^45.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
